# Public website configuration is in assets/preparation/backend.mjs.
# Never expose any of the following in frontend variables or commit real values.
SUPABASE_URL=https://wofazcvfvazfkvujwwcw.supabase.co
SUPABASE_SECRET_KEY=
# Supabase Management API/CLI deployment token, not a project data API secret:
SUPABASE_ACCESS_TOKEN=
# Edge Function secrets (SUPABASE_URL and legacy SERVICE_ROLE are injected by Supabase):
PUBLIC_APP_ORIGIN=https://greencardapplicationservices.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Gmail SMTP (Google App Password, never the account password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=greencardapplicationservices@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=greencardapplicationservices@gmail.com
# Optional alternative: leave SMTP_HOST blank to use SendGrid instead.
SENDGRID_API_KEY=
# Activate accounts only after real Google sign-in passes; checkout after real payment/webhook tests.
# SMTP is independently required for preparation notifications, not OAuth login.
GCAS_AUTH_READY=false
GCAS_CHECKOUT_ENABLED=false
